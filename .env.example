# Optional overrides. No secrets are needed: every wallet is generated in memory and discarded.
# Never put a real private key here.

# Local anvil fork RPC used by e2e:fork
FORK_RPC=http://127.0.0.1:8546
# Upstream Base mainnet RPC that anvil forks from (public, no API key). If you use a keyed RPC, keep it out of git.
UPSTREAM_RPC=https://base-rpc.publicnode.com
# AAPLc amount to supply in the fork, in base units (8 decimals). 5920000 = 0.0592 AAPLc ~ US$20
AAPLC_UNITS=5920000
# x402 endpoint paid by pay:sepolia (public demo seller on Base Sepolia)
ENDPOINT=https://wallets-demo-seller-server.calebgcarithers.workers.dev/weather?location=Buenos%20Aires
